
# Compose defaults. Copy to .env if you want to override anything.
APP_NAME=AI Automation Command Center
APP_VERSION=3.5.0
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL (optional externally managed Supabase connection for durable run history)
DATABASE_URL=
POSTGRES_PASSWORD=

# Demo mode
DEMO_MODE=false
LLM_PROVIDER=litellm
OPENAI_API_KEY=
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_MODEL=portfolio-free
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=0
INPUT_COST_PER_MILLION=0.15
OUTPUT_COST_PER_MILLION=0.60

# API authentication / role-based authorization
# Keep false for unsecured local development.
API_AUTH_ENABLED=true

# Legacy API_KEY is treated as admin. Do not pass it to a public UI.
API_KEY=

# Separate role credentials. API_*_KEYS are configured on the API service.
API_VIEWER_KEYS=
API_OPERATOR_KEYS=
API_REVIEWER_KEYS=
API_ADMIN_KEYS=

# The UI receives only the operator key by default. Reviewer/admin keys should
# be entered by an authorized person or injected only into a private UI.
API_OPERATOR_KEY=
API_REVIEWER_KEY=
API_ADMIN_KEY=

# Server-assigned audit identities.
API_REVIEWER_NAME=Configured Reviewer
API_ADMIN_NAME=API administrator

CORS_ORIGINS=http://localhost:8501

# Scheduled automation
SCHEDULE_ENABLED=false
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_WORKFLOW=competitor
SCHEDULE_COMPETITORS=Example Protocol,Example AI Startup

# Observability
OTEL_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Host ports
API_PORT=8000
UI_PORT=8501
RUN_REQUEST_TIMEOUT_SECONDS=150
API_STARTUP_TIMEOUT_SECONDS=90
API_STARTUP_RETRY_INTERVAL_SECONDS=4
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# LLM Gateway (LiteLLM)
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# LiteLLM upstream model IDs
OPENROUTER_LITELLM_MODEL=openrouter/openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest

# Cloud/demo mode
INLINE_EXECUTION=false

# Shared Portfolio LLM Gateway (BYOK)
# PORTFOLIO_SESSION_GATEWAY_URL is the Gateway origin (no /v1 suffix); the
# Streamlit UI uses it only to exchange one-time handoff codes.
PORTFOLIO_SESSION_GATEWAY_URL=
# LLM_GATEWAY_URL is the OpenAI-compatible inference base and includes /v1.
# Example: https://your-portfolio-llm-gateway.example.com/v1
LLM_GATEWAY_URL=
LLM_GATEWAY_ALLOWED_HOSTS=portfolio-llm-gateway.onrender.com
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# This variable is read through the FLOWPILOT_GATEWAY_CREDENTIAL_KEY settings alias.
# Keep identical in API and worker containers. Never commit this key.
FLOWPILOT_GATEWAY_CREDENTIAL_KEY=
# Encrypted BYOK records expire after this many seconds (60–1800).
GATEWAY_JOB_CREDENTIAL_TTL_SECONDS=900
