# Compose defaults. Copy to .env if you want to override anything.
APP_NAME=AI Automation Command Center
APP_VERSION=3.3.0
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# Demo mode is credential-free and works out of the box.
DEMO_MODE=false
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=portfolio-free
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
INPUT_COST_PER_MILLION=0.15
OUTPUT_COST_PER_MILLION=0.60

# Optional API authentication
API_AUTH_ENABLED=false
API_KEY=
CORS_ORIGINS=http://localhost:8501

# Scheduled automation
SCHEDULE_ENABLED=true
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_WORKFLOW=competitor
SCHEDULE_COMPETITORS=Example Protocol,Example AI Startup

# Observability
OTEL_ENABLED=true
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Host ports
API_PORT=8000
UI_PORT=8501
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# LLM Gateway (LiteLLM)
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# LiteLLM upstream model IDs
OPENROUTER_LITELLM_MODEL=openrouter/free
GEMINI_LITELLM_MODEL=gemini/gemini-flash-lite-latest

# Cloud/demo mode: execute workflows inside the API instead of Redis worker
INLINE_EXECUTION=false
